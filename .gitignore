x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017/2019/2022/2026 cache/options directory
.vs/
.idea/

# .NET Core / NuGet
project.lock.json
project.fragment.lock.json
artifacts/
*.nuget.props
*.nuget.targets
workflows.json

# SQLite
*.db
*.db-shm
